#!/bin/sh
set -eu

if command -v systemctl >/dev/null 2>&1; then
    if systemctl is-active --quiet orion-probe.service; then
        systemctl stop orion-probe.service
    fi
    if [ "${1:-}" = remove ]; then
        if systemctl is-enabled --quiet orion-probe.service; then
            systemctl disable orion-probe.service
        fi
    fi
    systemctl daemon-reload
fi

exit 0
